{
  "defaults": {
    "account": "tiktok_main",
    "template": "vertical_reel_v1",
    "metadata": {
      "language": "fr",
      "platform": "short_video",
      "voice_profile": "fr-default",
      "anti_repetition": {
        "lock_script_profile": true,
        "window_size": 6,
        "exclusion_window_size": 2,
        "allowed_variation_fields": [
          "script_hook_family",
          "script_proof_mode",
          "script_cta_family",
          "script_body_structure",
          "visual_asset_mode",
          "visual_theme",
          "visual_layout_variant"
        ]
      },
      "editorial_profile_map": {
        "by_niche": {
          "scroll_retention": "hooks",
          "caption_retention": "subtitles",
          "content_repurpose": "repurpose",
          "ai_pipeline": "automation"
        },
        "topic_rules": [
          {
            "contains_any": ["subtitle", "subtitles", "caption", "captions"],
            "profile": "subtitles",
            "reason": "caption wording"
          },
          {
            "contains_any": ["workflow", "automation", "pipeline", "agent"],
            "profile": "automation",
            "reason": "ops wording"
          },
          {
            "contains_any": ["idea", "ideas", "repurpose", "series"],
            "profile": "repurpose",
            "reason": "repurpose wording"
          },
          {
            "contains_any": ["hook", "hooks", "scroll", "retention", "opening"],
            "profile": "hooks",
            "reason": "hook wording"
          }
        ]
      }
    }
  },
  "topics": [
